{
  "name": "daily-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.9.2",
    "pnpm": ">=10.26.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scheron/Daily.git"
  },
  "scripts": {
    "dev": "pnpm --filter @daily/desktop dev",
    "release": "node scripts/release.js",
    "build:server": "pnpm --filter @daily/server build",
    "build:server:package": "pnpm build:server && node scripts/build-server-package.js",
    "fix:assets": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/fix-asset-extensions.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write apps packages",
    "typecheck:protocol": "tsc --noEmit --project packages/protocol/tsconfig.json",
    "typecheck:std": "tsc --noEmit --project packages/std/tsconfig.json",
    "typecheck:core": "tsc --noEmit --project packages/core/src/tsconfig.json",
    "typecheck:main": "pnpm --filter @daily/desktop typecheck:main",
    "typecheck:renderer": "pnpm --filter @daily/desktop typecheck:renderer",
    "typecheck:server": "pnpm --filter @daily/server typecheck",
    "typecheck:website": "tsc --noEmit --project apps/website/tsconfig.json",
    "typecheck:all": "pnpm typecheck:protocol && pnpm typecheck:std && pnpm typecheck:core && pnpm typecheck:main && pnpm typecheck:renderer && pnpm typecheck:server && pnpm typecheck:website",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "circular": "node scripts/check-circular.js",
    "bundle:size": "node scripts/bundle-size.js",
    "evitest": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs",
    "test": "pnpm evitest run",
    "test:watch": "pnpm evitest",
    "test:coverage": "pnpm evitest run --coverage",
    "check:all": "pnpm lint && pnpm typecheck:all && pnpm circular && pnpm test"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ],
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "^4.1.1",
    "@vue/tsconfig": "^0.7.0",
    "chalk": "^4.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.1",
    "vue-eslint-parser": "^10.1.3",
    "yaml": "^2.8.2"
  }
}
