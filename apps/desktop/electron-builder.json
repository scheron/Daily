{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.dailyapp.daily",
  "productName": "Daily",
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "copyright": "Copyright © 2025 Infected by JS",
  "directories": {
    "buildResources": "public",
    "output": "dist"
  },
  "afterPack": "scripts/afterPack-mac.js",
  "extraResources": [
    {"from": "resources/file-coordinator", "to": "file-coordinator"},
    {"from": "resources/models.json", "to": "models.json"},
    {"from": "public/icon.icns", "to": "icon.icns"}
  ],
  "files": [
    "out/**/*",
    {"filter": ["icon.png", "trayTemplate.png", "trayTemplate@2x.png"], "from": "public", "to": "resources"},
    "!dist",
    "!scripts",
    "!src",
    "!*.md",
    "!.git*",
    "!.DS_Store"
  ],
  "mac": {
    "artifactName": "${productName}-${version}-mac.${ext}",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": true,
    "identity": null,
    "icon": "Daily.icon",
    "target": [{"target": "dmg", "arch": ["arm64"]}]
  },
  "dmg": {
    "icon": "icon.icns"
  },
  "publish": null
}
