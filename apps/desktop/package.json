{
  "name": "@daily/desktop",
  "version": "0.39.1",
  "productName": "Daily",
  "description": "Daily - A minimal daily tasks management app",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "keywords": [
    "daily",
    "daily-app",
    "daily-tasks",
    "tasks-management",
    "todos",
    "productivity"
  ],
  "author": {
    "name": "Scheron",
    "url": "https://github.com/scheron"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "DAILY_DEMO=1 electron-vite dev --entry out-demo/main/main.js",
    "demo:build": "bash scripts/build-file-coordinator.sh && DAILY_DEMO=1 electron-vite build && electron-builder --config electron-builder.demo.json --mac --dir",
    "demo:open": "open 'dist-demo/mac-arm64/Daily Demo.app'",
    "demo:reset": "node scripts/reset-demo.js",
    "build": "bash scripts/build-file-coordinator.sh && electron-vite build && electron-builder --mac",
    "build:compress": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:main": "tsc --noEmit --project src/main/tsconfig.json",
    "typecheck:renderer": "vue-tsc --noEmit --project src/renderer/tsconfig.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@daily/core": "workspace:*",
    "@daily/protocol": "workspace:*",
    "@daily/std": "workspace:*",
    "@daily/tools": "workspace:*",
    "@emoji-mart/data": "1.2.1",
    "@floating-ui/vue": "^1.1.6",
    "@isaacs/ttlcache": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-bubble-menu": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "@tiptap/vue-3": "3.32.2",
    "@vueuse/core": "^13.1.0",
    "better-sqlite3": "^12.8.0",
    "buffer": "^5.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "emoji-mart": "5.6.0",
    "fast-sort": "^3.4.1",
    "fs-extra": "^11.3.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.12",
    "lowlight": "3.3.0",
    "luxon": "^3.6.1",
    "markdown-it": "^14.2.0",
    "marked": "17.0.6",
    "nanoid": "^5.1.5",
    "pinia": "^3.0.2",
    "tailwind-merge": "^3.2.0",
    "undici": "^8.5.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-toasts-lite": "^0.1.9",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.6.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^36.3.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "happy-dom": "^20.8.4",
    "tailwindcss": "^4.1.8",
    "terser": "^5.40.0",
    "type-fest": "^5.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vue-tsc": "^2.2.8"
  }
}
